# Copy to .env and adjust. Never commit .env.
PROJECT_NAME=interactive-movie

# Caddy site address for the production stack (compose.yml). ":80" serves plain
# HTTP locally; set the bare domain on the server and Caddy issues the
# certificate automatically. No scheme here — with "https://" Caddy never
# starts the ACME challenge.
SITE_ADDRESS=:80

# Host that only redirects to SITE_ADDRESS. Set it once the www DNS record
# exists; leaving it unset keeps Caddy from requesting a cert it cannot get.
# WWW_ADDRESS=www.example.de

# Host port for the dev stack (compose.dev.yml). Bound to loopback only.
DEV_PORT=5173

# Folder holding clips/ and audio/, bind-mounted into the production container.
# Unset it locally to serve what prepare-media.sh wrote into frontend/public.
# On the server this is the folder push-media.sh rsyncs into.
# MEDIA_DIR=/srv/interactive-movie/media
