# Serves the static Vite build directly - no application server behind it.
# Defaults to plain HTTP on :80 for a local prod smoke test. Set SITE_ADDRESS
# to the domain on the server and Caddy provisions the certificate itself.
{$SITE_ADDRESS::80} {
	root * /srv

	# Caddy only compresses text-ish content types by default, so the mp4
	# clips pass through untouched and are not needlessly re-encoded.
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Videos are immutable once delivered - let browsers cache them hard.
	# No Accept-Ranges here: file_server answers range requests on its own,
	# so seeking in long clips works without extra configuration.
	header /clips/* Cache-Control "public, max-age=31536000, immutable"

	# Vite hashes asset filenames, so a given URL never changes content and
	# the browser can skip revalidating it entirely.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	# Everything else ends up at index.html through the fallback below. It
	# carries the references to the hashed assets, so a stale copy would pin
	# the app to an old build - revalidate it on every load. Matching by
	# exclusion is deliberate: header runs before try_files, so a rule on
	# /index.html would miss both "/" and deep links like /board.
	@html not path /clips/* /assets/*
	header @html Cache-Control "no-cache"

	# Single page app: any unknown path falls back to index.html.
	try_files {path} /index.html
	file_server
}

# www is a redirect, not a second copy of the site. WWW_ADDRESS is unset
# locally, so this block collapses to a dummy host and requests no certificate.
{$WWW_ADDRESS:www.localhost} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}
